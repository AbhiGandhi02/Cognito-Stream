# Lockfiles are committed (NOT ignored) so Render/Vercel get the exact same
# resolved dependency tree that works locally. Transitive deps drift otherwise
# (e.g. @types/express-serve-static-core tightening req.params to string|string[]).
renderer/.mypy_cache/
storage/

# Claude Code MCP config — contains a Supabase access token, do not commit.
.mcp.json

# Local-only Compose overrides (machine-specific port remaps, e.g. macOS
# AirPlay Receiver squatting on host 5000). Compose auto-loads this file, so
# committing it would force one machine's workaround on every contributor.
docker-compose.override.yml
