// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The IDE flags `url` as deprecated (Prisma 7 rules), but the installed
  // Prisma 5.22 REQUIRES this line for `prisma migrate`. Leave it.
  url      = env("DATABASE_URL")
}

model Storyboard {
  id              String   @id @default(cuid())
  // Supabase auth user id (UUID from auth.users). Nullable for legacy rows
  // that pre-date auth; new rows must always be authored.
  userId          String?  @db.Uuid
  title           String
  description     String
  prompt          String   @db.Text
  status          String   @default("draft") // draft, processing, completed, failed
  finalVideoUrl   String?
  totalDuration   Float?
  // Top-level error captured when storyboard generation itself fails (e.g.
  // Gemini outage during initial scene-planning). Per-scene errors live
  // on the Scene rows.
  errorMessage    String?  @db.Text
  // When set, this storyboard was cloned from a pre-rendered "suggestion"
  // template. The clone owns its own row + scenes so it appears in the
  // user's history, but the LLM/renderer is short-circuited — code and
  // final video are copied lazily from the source as the user clicks
  // Generate Code / Render Final Video. Invisible to the user.
  demoSourceId    String?
  // The video brief decided once by expandPrompt: the worked example, its
  // literal values, key terms, the beat sheet and the scope note. Stored as
  // JSON text because it is read whole and never queried into.
  //
  // Previously discarded after planning, which meant a scene retried later had
  // no access to the example every other scene was built around — it could only
  // infer it from its own visualDescription and facts scraped out of sibling
  // scenes' Python. Also carries scopeNote, the brief's own statement of what
  // it left out, which is the only record that a broad topic was narrowed.
  brief           String?  @db.Text

  scenes          Scene[]
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([userId])
}

model Scene {
  id                  String      @id @default(cuid())
  storyboardId        String
  sceneNumber         Int

  narration           String      @db.Text
  visualDescription   String      @db.Text
  manimCode           String      @db.Text // JSON string of Manim operations

  estimatedDuration   Float
  actualDuration      Float?

  audioUrl            String?
  videoUrl            String?
  // First-frame jpg for the dashboard breakdown poster. Tiny (~10 KB),
  // uploaded once when the scene's mp4 is rendered. Optional so old rows
  // (rendered before this column existed) keep working.
  thumbnailUrl        String?

  status              String      @default("pending") // pending, processing, completed, failed
  // Last error message encountered for this scene (rendering error, AI
  // generation failure, etc.). Surfaces to admins for diagnostic view.
  errorMessage        String?     @db.Text
  // How many AI-driven correction attempts were made before the scene
  // either succeeded or gave up. Useful signal for admins.
  correctionAttempts  Int         @default(0)

  storyboard          Storyboard  @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([storyboardId, sceneNumber])
  @@index([storyboardId])
  @@index([status])
}

enum Role {
  USER
  ADMIN
}

// User profile, mirrored from Supabase Auth.
// `id` is the Supabase auth.users UUID (NOT a cuid — we don't auto-generate).
// We upsert a row here on the first authenticated request from each user.
model User {
  id            String       @id @db.Uuid
  email         String       @unique
  name          String?
  role          Role         @default(USER)

  storyboards   Storyboard[]

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// Optional: Render job queue for async processing
model RenderJob {
  id            String    @id @default(cuid())
  sceneId       String?
  storyboardId  String?
  
  type          String    // "scene" or "final"
  status        String    @default("queued") // queued, processing, completed, failed
  
  startedAt     DateTime?
  completedAt   DateTime?
  
  errorMessage  String?   @db.Text
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([status])
  @@index([createdAt])
}