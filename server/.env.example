# ===========================================
# Cognito Stream Server - Environment Variables
# ===========================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# AI Services
# PRIMARY = free-tier key (project with NO billing account) — tried first.
# SECONDARY = paid key — takes over automatically on a quota/429 error.
GEMINI_API_KEY_PRIMARY="your-free-tier-gemini-api-key"
GEMINI_API_KEY_SECONDARY="your-paid-gemini-api-key"
# Scene planning and any other text call. An easy task — segment a topic into
# scenes and fill a schema Gemini enforces — and one call per video, so a
# simpler, faster model is enough.
GEMINI_MODEL="gemini-2.5-flash"

# Writing and repairing Manim code. The hard task, and the expensive one to get
# wrong: a weaker model here means more broken scripts, and every repair costs
# another full render. Keep this on the stronger flash model.
GEMINI_CODE_MODEL="gemini-3.7-flash"
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV  # Optional: Default is Antoni voice

# Renderer Service
RENDERER_URL="http://localhost:5000"

# Scenes rendered in parallel. Match this to the renderer's CPU count — Manim
# is CPU-bound, so a value above the core count just timeshares and adds memory
# pressure. Does not affect code generation, which is always sequential.
SCENE_CONCURRENCY=2

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Cloud Storage (for production)
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""

# ---------------------------------------------------------------
# Gemini request pacing (ApiRequestsPerMinutePerProjectPerRegion)
# ---------------------------------------------------------------
# Requests per rolling minute the server will issue, PER KEY. The Google quota
# is per PROJECT, so these are independent only while the two keys live in
# different projects — if they share one, set each to half the project limit.
# Counts every API call, including countTokens, not just generation.
# Default 15. Lower it if you see 429s; raise it once the quota is increased.
# Default is 5 — the quota this project was measured to have. Raise once you
# have confirmed the real per-project limit in the Google Cloud console.
GEMINI_RPM_PRIMARY=5
GEMINI_RPM_SECONDARY=5

# System-prompt context caching. 'off' sends the prompt inline on every scene
# (identical output, ~10x the input cost). TTL is in seconds.
GEMINI_CACHE=on
GEMINI_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------
# Renderer access control  (REQUIRED — see BACKLOG.md item 13)
# ---------------------------------------------------------------
# The renderer executes arbitrary Python via /render-code. Without this secret
# it serves ANY caller, which is remote code execution against a container that
# holds SUPABASE_SERVICE_ROLE_KEY.
#
# Set the SAME value here and in the Hugging Face Space's variables. When unset
# on both sides the renderer still serves and warns loudly, so a deploy cannot
# break — but the endpoint stays open until you set it.
#
# Generate one with:  openssl rand -hex 32
RENDERER_SHARED_SECRET=
