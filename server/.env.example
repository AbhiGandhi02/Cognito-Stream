# ===========================================
# Cognito Stream Server - Environment Variables
# ===========================================

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# AI Services
# PRIMARY = free-tier key (project with NO billing account) — tried first.
# SECONDARY = paid key — takes over automatically on a quota/429 error.
GEMINI_API_KEY_PRIMARY="your-free-tier-gemini-api-key"
GEMINI_API_KEY_SECONDARY="your-paid-gemini-api-key"
# Scene planning and any other text call. An easy task — segment a topic into
# scenes and fill a schema Gemini enforces — and one call per video, so a
# simpler, faster model is enough.
GEMINI_MODEL="gemini-2.5-flash"

# Writing and repairing Manim code. The hard task, and the expensive one to get
# wrong: a weaker model here means more broken scripts, and every repair costs
# another full render. Keep this on the stronger flash model.
GEMINI_CODE_MODEL="gemini-3.7-flash"
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=ErXwobaYiN019PkySvjV  # Optional: Default is Antoni voice

# Renderer Service
RENDERER_URL="http://localhost:5000"

# Scenes rendered in parallel. Match this to the renderer's CPU count — Manim
# is CPU-bound, so a value above the core count just timeshares and adds memory
# pressure. Does not affect code generation, which is always sequential.
SCENE_CONCURRENCY=2

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional: Cloud Storage (for production)
# STORAGE_BUCKET=""
# STORAGE_ACCESS_KEY=""
# STORAGE_SECRET_KEY=""
